<?xml version="1.0" encoding="UTF-8"?>
<UserConfig>
  <Group id="ControllerCustomizer" displayName="controller_customizer" tags="customDisplayName">
    <VisibleVars>
      <Var id="Scheme" displayName="Controller scheme" displayType="OPTIONS" tags="nonLocalized;nonLocalizedName;customNames" value="-1">
        <OptionsArray>
          <Option id="0" displayName="Current (original)">
            <Entry varId="Scheme" value="0" />
          </Option>
          <Option id="1" displayName="DarkSoul">
            <Entry varId="Scheme" value="1" />
          </Option>
          <Option id="2" displayName="DarkSoul Alt1">
            <Entry varId="Scheme" value="2" />
          </Option>
        </OptionsArray>
      </Var>
      <Var id="Preset" displayName="Hold: canter; double-press + hold: gallop" displayType="OPTIONS" tags="nonLocalized;nonLocalizedName;customNames" value="-1" visibilityCondition="hideAlways">
        <OptionsArray>
          <Option id="0" displayName="Current: A to ride, L3 to interact">
            <Entry varId="Preset" value="0" />
          </Option>
          <Option id="1" displayName="Alt1: L3 to ride, A to interact">
            <Entry varId="Preset" value="1" />
          </Option>
        </OptionsArray>
      </Var>
      <Var id="DiagramProbe" displayName="Diagram probe" displayType="TOGGLE" visibilityCondition="hideAlways" value="false" />
      <Var id="ContextProbe" displayName="Context probe" displayType="TOGGLE" visibilityCondition="hideAlways" value="false" />
    </VisibleVars>
  </Group>
</UserConfig>
