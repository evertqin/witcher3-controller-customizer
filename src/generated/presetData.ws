    return "";
}

function CCGeneratedPresetName(preset : int) : string
{
    if (preset == 0) { return "Current"; }
    if (preset == 1) { return "Alt1"; }
    return "";
}

function CCGeneratedHorseSpeedText() : string
{
    return GetLocStringByKeyExt("ControlLayout_hold") + " - " + GetLocStringByKeyExt("ControlLayout_Canter") + "<br/>" +
        GetLocStringByKeyExt("ControlLayout_doubleTap") + " + " + GetLocStringByKeyExt("ControlLayout_hold") + " - " + GetLocStringByKeyExt("ControlLayout_Gallop");
}

function CCGeneratedSharedDiagramRow(row : CScriptedFlashObject)
{
    var labels : array<string>;
    labels.PushBack(row.GetMemberFlashString("txtXButton"));
    labels.PushBack(row.GetMemberFlashString("txtYButton"));
    labels.PushBack(row.GetMemberFlashString("txtRightBumper"));
    labels.PushBack(row.GetMemberFlashString("txtRightTrigger"));
    labels.PushBack(row.GetMemberFlashString("txtLeftBumper"));
    labels.PushBack(row.GetMemberFlashString("txtLeftTrigger"));
    row.SetMemberFlashString("txtRightBumper", labels[0]);
    row.SetMemberFlashString("txtRightTrigger", labels[1]);
    row.SetMemberFlashString("txtLeftTrigger", labels[2]);
    row.SetMemberFlashString("txtXButton", labels[3]);
    row.SetMemberFlashString("txtYButton", labels[4]);
    row.SetMemberFlashString("txtLeftBumper", labels[5]);
}
