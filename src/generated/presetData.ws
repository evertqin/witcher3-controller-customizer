            return 'Horse';
        case 'CC_PROBE_Current_Horse_Replacer_Ciri':
        case 'CC_PROBE_Alt1_Horse_Replacer_Ciri':
            return 'Horse_Replacer_Ciri';
        case 'CC_PROBE_Current_ScriptedAction':
        case 'CC_PROBE_Alt1_ScriptedAction':
            return 'ScriptedAction';
    }
    return contextName;
}

function CCGeneratedResolveContext(baseContext : name, preset : int) : name
{
    switch (baseContext)
    {
        case 'BASE_INTERACTIONS_HORSE':
            if (preset == 0) { return 'CC_PROBE_Current_BASE_INTERACTIONS_HORSE'; }
            if (preset == 1) { return 'CC_PROBE_Alt1_BASE_INTERACTIONS_HORSE'; }
            return baseContext;
        case 'Horse':
            if (preset == 0) { return 'CC_PROBE_Current_Horse'; }
            if (preset == 1) { return 'CC_PROBE_Alt1_Horse'; }
            return baseContext;
        case 'Horse_Replacer_Ciri':
            if (preset == 0) { return 'CC_PROBE_Current_Horse_Replacer_Ciri'; }
            if (preset == 1) { return 'CC_PROBE_Alt1_Horse_Replacer_Ciri'; }
            return baseContext;
        case 'ScriptedAction':
            if (preset == 0) { return 'CC_PROBE_Current_ScriptedAction'; }
            if (preset == 1) { return 'CC_PROBE_Alt1_ScriptedAction'; }
            return baseContext;
    }
    return baseContext;
}

function CCGeneratedHorseSpeedMember(preset : int, ciri : bool) : string
{
    if (preset == 0)
    {
        if (ciri) { return "txtAButton"; }
        if (!ciri) { return "txtAButton"; }
    }
    if (preset == 1)
    {
        if (ciri) { return "txtLeftJoy"; }
        if (!ciri) { return "txtLeftJoy"; }
    }
    return "";
}

function CCGeneratedHorseInteractionMember(preset : int) : string
{
