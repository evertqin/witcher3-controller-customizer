            theInput.ForceDeactivateAction('CastSignHold');
            theInput.ForceDeactivateAction('Finish');
            theInput.ForceDeactivateAction('Finisher');
            theInput.ForceDeactivateAction('Focus');
            theInput.ForceDeactivateAction('RadialMenu');
            theInput.ForceDeactivateAction('Spare');
            theInput.ForceDeactivateAction('SpecialAttackHeavy');
            theInput.ForceDeactivateAction('SpecialAttackLight');
            theInput.ForceDeactivateAction('ThrowItem');
            theInput.ForceDeactivateAction('ThrowItemHold');
            return;
        case 'Exploration_Replacer_Ciri':
            theInput.ForceDeactivateAction('AttackLight');
            theInput.ForceDeactivateAction('CiriAttackHeavy');
            theInput.ForceDeactivateAction('CiriSpecialAttack');
            theInput.ForceDeactivateAction('CiriSpecialAttackHeavy');
            theInput.ForceDeactivateAction('Finish');
            theInput.ForceDeactivateAction('Finisher');
            theInput.ForceDeactivateAction('Focus');
            theInput.ForceDeactivateAction('RadialMenu');
            theInput.ForceDeactivateAction('Spare');
            theInput.ForceDeactivateAction('ThrowItem');
            theInput.ForceDeactivateAction('ThrowItemHold');
            return;
        case 'Horse':
            theInput.ForceDeactivateAction('Canter');
            theInput.ForceDeactivateAction('Container');
            theInput.ForceDeactivateAction('FastTravel');
            theInput.ForceDeactivateAction('Focus');
            theInput.ForceDeactivateAction('Follow');
            theInput.ForceDeactivateAction('Gallop');
            theInput.ForceDeactivateAction('GatherHerbs');
            theInput.ForceDeactivateAction('HorseKick');
            theInput.ForceDeactivateAction('RadialMenu');
            theInput.ForceDeactivateAction('Use');
            theInput.ForceDeactivateAction('VehicleAttack');
            theInput.ForceDeactivateAction('VehicleCastSign');
            theInput.ForceDeactivateAction('VehicleItemAction');
            theInput.ForceDeactivateAction('VehicleItemActionHold');
            return;
        case 'Horse_Replacer_Ciri':
            theInput.ForceDeactivateAction('Canter');
            theInput.ForceDeactivateAction('Follow');
            theInput.ForceDeactivateAction('Gallop');
            theInput.ForceDeactivateAction('HorseKick');
            theInput.ForceDeactivateAction('RadialMenu');
            theInput.ForceDeactivateAction('VehicleAttack');
            return;
        case 'JumpClimb':
            theInput.ForceDeactivateAction('DiveDown');
            theInput.ForceDeactivateAction('RadialMenu');
            return;
        case 'RadialMenu':
            theInput.ForceDeactivateAction('Alternate');
            theInput.ForceDeactivateAction('LockAndGuard');
            theInput.ForceDeactivateAction('OpenMeditation');
            theInput.ForceDeactivateAction('RadialMenu');
            return;
        case 'ScriptedAction':
            theInput.ForceDeactivateAction('Gallop');
            return;
        case 'Swimming':
            theInput.ForceDeactivateAction('DiveDown');
            theInput.ForceDeactivateAction('Finish');
            theInput.ForceDeactivateAction('Finisher');
            theInput.ForceDeactivateAction('Focus');
            theInput.ForceDeactivateAction('RadialMenu');
            theInput.ForceDeactivateAction('Spare');
            theInput.ForceDeactivateAction('ThrowItem');
            theInput.ForceDeactivateAction('ThrowItemHold');
            return;
        case 'ThrowHold':
            theInput.ForceDeactivateAction('ThrowItem');
            theInput.ForceDeactivateAction('ThrowItemHold');
            return;
        case 'ThrowHoldChain':
            theInput.ForceDeactivateAction('AttackHeavy');
            theInput.ForceDeactivateAction('AttackLight');
            theInput.ForceDeactivateAction('ThrowItem');
            theInput.ForceDeactivateAction('ThrowItemHold');
            return;
    }
}
function CCGeneratedHorseSpeedMember(preset : int, ciri : bool) : string
{
    if (preset == 1)
    {
        if (ciri) { return "txtAButton"; }
        if (!ciri) { return "txtAButton"; }
    }
    if (preset == 2)
    {
        if (ciri) { return "txtLeftJoy"; }
        if (!ciri) { return "txtLeftJoy"; }
    }
    return "";
}

function CCGeneratedHorseInteractionMember(preset : int) : string
{
    if (preset == 1) { return "txtLeftJoy"; }
    if (preset == 2) { return "txtAButton"; }
    return "";
}

function CCGeneratedPresetName(preset : int) : string
{
    if (preset == 0) { return "Current (original)"; }
    if (preset == 1) { return "DarkSoul"; }
    if (preset == 2) { return "DarkSoul Alt1"; }
    return "";
}

function CCGeneratedHorseSpeedText() : string
{
    return GetLocStringByKeyExt("ControlLayout_hold") + " - " + GetLocStringByKeyExt("ControlLayout_Canter") + "<br/>" +
        GetLocStringByKeyExt("ControlLayout_doubleTap") + " + " + GetLocStringByKeyExt("ControlLayout_hold") + " - " + GetLocStringByKeyExt("ControlLayout_Gallop");
}

function CCGeneratedSharedDiagramRow(row : CScriptedFlashObject)
{
    var labels : array<string>;
    labels.PushBack(row.GetMemberFlashString("txtXButton"));
    labels.PushBack(row.GetMemberFlashString("txtYButton"));
    labels.PushBack(row.GetMemberFlashString("txtRightBumper"));
    labels.PushBack(row.GetMemberFlashString("txtRightTrigger"));
    labels.PushBack(row.GetMemberFlashString("txtLeftBumper"));
    labels.PushBack(row.GetMemberFlashString("txtLeftTrigger"));
    row.SetMemberFlashString("txtRightBumper", labels[0]);
    row.SetMemberFlashString("txtRightTrigger", labels[1]);
    row.SetMemberFlashString("txtLeftTrigger", labels[2]);
    row.SetMemberFlashString("txtXButton", labels[3]);
    row.SetMemberFlashString("txtYButton", labels[4]);
    row.SetMemberFlashString("txtLeftBumper", labels[5]);
}
