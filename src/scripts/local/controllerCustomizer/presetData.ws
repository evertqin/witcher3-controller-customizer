function CCGeneratedReleaseContextActions(contextName : name)
{
    switch (CCGeneratedCanonicalContext(contextName))
    {
        case 'BASE_ALL_ATTACKS':
            theInput.ForceDeactivateAction('AttackHeavy');
            theInput.ForceDeactivateAction('AttackLight');
            theInput.ForceDeactivateAction('SpecialAttackHeavy');
            theInput.ForceDeactivateAction('SpecialAttackLight');
            return;
        case 'BASE_ATTACKS_NO_LIGHT':
            theInput.ForceDeactivateAction('AttackHeavy');
            theInput.ForceDeactivateAction('SpecialAttackHeavy');
            return;
        case 'BASE_ATTACK_HEAVY':
            theInput.ForceDeactivateAction('AttackHeavy');
            return;
        case 'BASE_ATTACK_LIGHT':
            theInput.ForceDeactivateAction('AttackLight');
            return;
        case 'BASE_FocusMode':
            theInput.ForceDeactivateAction('Focus');
            return;
        case 'BASE_INTERACTIONS_HORSE':
            theInput.ForceDeactivateAction('Follow');
            return;
        case 'BASE_INTERACTIONS_PAD':
            theInput.ForceDeactivateAction('Finish');
            theInput.ForceDeactivateAction('Finisher');
            theInput.ForceDeactivateAction('Spare');
            return;
        case 'BASE_Interactions':
            theInput.ForceDeactivateAction('Finish');
            theInput.ForceDeactivateAction('Finisher');
            theInput.ForceDeactivateAction('Spare');
            return;
        case 'BASE_Items':
            theInput.ForceDeactivateAction('ThrowItem');
            theInput.ForceDeactivateAction('ThrowItemHold');
            return;
        case 'BASE_SHOW_RADIAL_MENU':
            theInput.ForceDeactivateAction('RadialMenu');
            return;
        case 'BASE_SPECIAL_ATTACK_HEAVY':
            theInput.ForceDeactivateAction('SpecialAttackHeavy');
            return;
        case 'BASE_SPECIAL_ATTACK_LIGHT':
            theInput.ForceDeactivateAction('SpecialAttackLight');
            return;
        case 'BASE_Signs':
            theInput.ForceDeactivateAction('CastSign');
            theInput.ForceDeactivateAction('CastSignHold');
            return;
        case 'Boat':
            theInput.ForceDeactivateAction('Focus');
            theInput.ForceDeactivateAction('GI_Decelerate');
            theInput.ForceDeactivateAction('RadialMenu');
            theInput.ForceDeactivateAction('VehicleItemAction');
            theInput.ForceDeactivateAction('VehicleItemActionHold');
            return;
        case 'BoatPassenger':
            theInput.ForceDeactivateAction('Focus');
            theInput.ForceDeactivateAction('RadialMenu');
            return;
        case 'Combat':
            theInput.ForceDeactivateAction('Alternate');
            theInput.ForceDeactivateAction('AttackHeavy');
            theInput.ForceDeactivateAction('AttackLight');
            theInput.ForceDeactivateAction('CastSign');
            theInput.ForceDeactivateAction('CastSignHold');
            theInput.ForceDeactivateAction('Finish');
            theInput.ForceDeactivateAction('Finisher');
            theInput.ForceDeactivateAction('LockAndGuard');
            theInput.ForceDeactivateAction('RadialMenu');
            theInput.ForceDeactivateAction('Spare');
            theInput.ForceDeactivateAction('SpecialAttackHeavy');
            theInput.ForceDeactivateAction('SpecialAttackLight');
            theInput.ForceDeactivateAction('ThrowItem');
            theInput.ForceDeactivateAction('ThrowItemHold');
            return;
        case 'Combat_Replacer_Ciri':
            theInput.ForceDeactivateAction('AttackLight');
            theInput.ForceDeactivateAction('CiriAttackHeavy');
            theInput.ForceDeactivateAction('CiriSpecialAttack');
            theInput.ForceDeactivateAction('CiriSpecialAttackHeavy');
            theInput.ForceDeactivateAction('Finish');
            theInput.ForceDeactivateAction('Finisher');
            theInput.ForceDeactivateAction('LockAndGuard');
            theInput.ForceDeactivateAction('RadialMenu');
            theInput.ForceDeactivateAction('Spare');
            theInput.ForceDeactivateAction('ThrowItem');
            return;
        case 'Diving':
            theInput.ForceDeactivateAction('DiveDown');
            theInput.ForceDeactivateAction('Finish');
            theInput.ForceDeactivateAction('Finisher');
            theInput.ForceDeactivateAction('Focus');
            theInput.ForceDeactivateAction('RadialMenu');
            theInput.ForceDeactivateAction('Spare');
            theInput.ForceDeactivateAction('ThrowItem');
